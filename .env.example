# Copier ce fichier en .env (jamais commité) et remplir les valeurs.
# Sur Azure : saisir ces variables dans App Service > Configuration > Paramètres d'application.

# --- Django ---
# Générer : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- PostgreSQL (local ou VM Azure) ---
DB_NAME=hospiplan
DB_USER=hospiplan_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# --- docker-compose (conteneur postgres) ---
POSTGRES_DB=hospiplan
POSTGRES_USER=hospiplan_app
POSTGRES_PASSWORD=
