# service-identite — copier en .env (jamais commité).
# Azure : App Service > Configuration > Paramètres d'application.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL — sur la VM : DB_USER=svc_identite, DB_SSLMODE=require
DB_NAME=hospiplan
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
DB_SCHEMA=identite

# Clés RSA des JWT : fichiers (local, `python manage.py generate_jwt_keys`)
JWT_PRIVATE_KEY_FILE=keys/jwt_private.pem
JWT_PUBLIC_KEY_FILE=keys/jwt_public.pem
# ... ou contenu PEM direct, retours à la ligne échappés en \n (Azure)
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Clients autorisés à demander un jeton de service (JSON sur une ligne).
# Générer chaque secret : python -c "import secrets;print(secrets.token_urlsafe(32))"
SERVICE_CLIENTS={"service-planning": {"secret": "", "scope": ["personnel:read"]}, "fn-planning-events": {"secret": "", "scope": ["personnel:read"]}}

THROTTLE_LOGIN=5/min
LOG_LEVEL=INFO

# Mot de passe des comptes de démo (commande seed_identite), 10 caractères minimum
SEED_PASSWORD=
